{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Terraform archetype (platform, terraform-provider-prefect). Groups provider and module bumps separately.",
  "packageRules": [
    {
      "description": "Group Terraform provider bumps together.",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "provider",
        "required_provider"
      ],
      "groupName": "terraform providers"
    },
    {
      "description": "Group Terraform module bumps together.",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "groupName": "terraform modules"
    }
  ]
}
